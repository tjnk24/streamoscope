{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["dom", "es2023"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "__e2e/*": ["./*"]
        }
    },
    "include": [".", "../playwright.config.ts"]
}
